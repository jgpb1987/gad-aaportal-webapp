@using gad.aaportal.commons.Dto.DtoPortal.Declaracion

<ToastsServices @ref="Toast" Time="5000" />
<LoadingBorderModalServices @ref="LoadingBorder" />
<ResumenEncabezadoContribuyenteForm />

<div class="consulta-declaraciones-container">
    <div class="consulta-declaraciones-card">
        <div class="consulta-declaraciones-header">
            <div>
                <div class="consulta-declaraciones-title">
                    Consulta de declaraciones
                </div>
                <div class="consulta-declaraciones-subtitle">
                    Revise las declaraciones registradas y reimprima el comprobante cuando lo requiera.
                </div>
            </div>

            <button type="button"
                    class="btn-consulta-refresh"
                    @onclick="RefrescarConsulta">
                Actualizar
            </button>
        </div>

        <div class="consulta-declaraciones-body">
            @if (_declaraciones.Any())
            {
                <div class="declaraciones-grid">
                    @foreach (var item in _declaraciones)
                    {
                        <div class="declaracion-consulta-card">
                            <div class="declaracion-card-header">
                                <div>
                                    <div class="declaracion-card-title">
                                        Declaración @item.Anio
                                    </div>
                                    <div class="declaracion-card-subtitle">
                                        Código: @item.CodigoUnicoPago
                                    </div>
                                </div>

                                <span class="declaracion-estado">
                                    Registrada
                                </span>
                            </div>

                            <div class="declaracion-card-info">
                                <div class="declaracion-info-item">
                                    <span>Fecha registro</span>
                                    <strong>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>

                                <div class="declaracion-info-item">
                                    <span>Total patente</span>
                                    <strong>@TotalPatente(item).ToString("N2")</strong>
                                </div>

                                <div class="declaracion-info-item">
                                    <span>Total 1.5 x mil</span>
                                    <strong>@TotalIat(item).ToString("N2")</strong>
                                </div>

                                <div class="declaracion-info-item total">
                                    <span>Total a pagar</span>
                                    <strong>@TotalDeclaracion(item).ToString("N2")</strong>
                                </div>
                            </div>

                            <div class="declaracion-card-actions">
                                <button type="button"
                                        class="btn-ver-detalle"
                                        @onclick="() => AbrirDetalleDeclaracion(item)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-declaraciones">
                    No existen declaraciones registradas.
                </div>
            }
        </div>
    </div>
</div>

@if (_mostrarModalDetalle && _declaracionSeleccionada is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-comprobante-card comprobante-simple-card">
            <div class="modal-detalle-header">
                <div>
                    <div class="modal-title-custom">Detalle de declaración</div>
                    <div class="modal-subtitle-custom">
                        Código único de pago: @_declaracionSeleccionada.CodigoUnicoPago
                    </div>
                </div>

                <button type="button"
                        class="btn-close-modal"
                        @onclick="CerrarDetalleDeclaracion">
                    ×
                </button>
            </div>

            <div class="modal-detalle-body comprobante-simple-body">
                <div id="comprobanteConsultaImprimir" class="comprobante-simple-box">

                    <div class="comprobante-simple-title">
                        <strong>GAD Municipal Antonio Ante</strong>
                        <span>Comprobante de declaración de patente</span>
                    </div>

                    <div class="comprobante-simple-section">
                        <div class="comprobante-simple-section-title">Datos de la declaración</div>

                        <div class="comprobante-simple-grid">
                            <div>
                                <span>Código único de pago</span>
                                <strong>@_declaracionSeleccionada.CodigoUnicoPago</strong>
                            </div>

                            <div>
                                <span>Identificación</span>
                                <strong>@_declaracionSeleccionada.Identificacion</strong>
                            </div>

                            <div>
                                <span>Fecha emisión</span>
                                <strong>@_declaracionSeleccionada.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div>
                                <span>Declaración Patente / Ejercicio fiscal I.R.</span>
                                <strong>@_declaracionSeleccionada.Anio / @(_declaracionSeleccionada.Anio-1)</strong>
                            </div>

                        </div>
                    </div>

                    <div class="comprobante-simple-section">
                        <div class="comprobante-simple-section-title">Información financiera declarada</div>

                        <div class="comprobante-simple-grid">
                            <div>
                                <span>Activo corriente</span>
                                <strong>@_declaracionSeleccionada.ActivoCorriente.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Activo no corriente</span>
                                <strong>@_declaracionSeleccionada.ActivoNoCorriente.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Total activo</span>
                                <strong>@TotalActivo(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Total pasivo</span>
                                <strong>@TotalPasivo(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Pasivo corriente</span>
                                <strong>@_declaracionSeleccionada.PasivoCorriente.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Pasivo no corriente</span>
                                <strong>@_declaracionSeleccionada.PasivoNoCorriente.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Pasivo contingente</span>
                                <strong>@_declaracionSeleccionada.PasivoContingente.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Patrimonio</span>
                                <strong>@Patrimonio(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Ingresos</span>
                                <strong>@_declaracionSeleccionada.Ingresos.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Costos y gastos</span>
                                <strong>@_declaracionSeleccionada.CostosGastos.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Utilidad</span>
                                <strong>@UtilidadEjercicio(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>

                            <div>
                                <span>Pérdida</span>
                                <strong>@PerdidaEjercicio(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="comprobante-simple-two-columns">
                        <div class="comprobante-simple-section">
                            <div class="comprobante-simple-section-title">Patente municipal</div>

                            <table class="comprobante-simple-table">
                                <tbody>
                                    <tr>
                                        <td>Patrimonio</td>
                                        <td>@Patrimonio(_declaracionSeleccionada).ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Valor patente</td>
                                        <td>@_declaracionSeleccionada.Patente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Bomberos</td>
                                        <td>@_declaracionSeleccionada.ValorBomberos.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Multa patente</td>
                                        <td>@_declaracionSeleccionada.MultaPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Interés patente</td>
                                        <td>@_declaracionSeleccionada.InteresPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Recargo patente</td>
                                        <td>@_declaracionSeleccionada.RecargoPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Costas patente</td>
                                        <td>@_declaracionSeleccionada.CostasPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Tasa administrativa</td>
                                        <td>@_declaracionSeleccionada.TasaAdministrativaPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Descuento tercera edad</td>
                                        <td>- @_declaracionSeleccionada.DescuentoTerceraEdadPatente.ToString("N2")</td>
                                    </tr>
                                    <tr class="comprobante-simple-subtotal">
                                        <td>Total patente</td>
                                        <td>@TotalPatente(_declaracionSeleccionada).ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="comprobante-simple-section">
                            <div class="comprobante-simple-section-title">1.5 x mil</div>

                            <table class="comprobante-simple-table">
                                <tbody>
                                    <tr>
                                        <td>Base imponible</td>
                                        <td>@Patrimonio(_declaracionSeleccionada).ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Valor 1.5 x mil</td>
                                        <td>@_declaracionSeleccionada.UnoCincoXMil.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Multa 1.5 x mil</td>
                                        <td>@_declaracionSeleccionada.MultaIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Interés 1.5 x mil</td>
                                        <td>@_declaracionSeleccionada.InteresIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Recargo 1.5 x mil</td>
                                        <td>@_declaracionSeleccionada.RecargoIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Costas 1.5 x mil</td>
                                        <td>@_declaracionSeleccionada.CostasIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Tasa administrativa</td>
                                        <td>@_declaracionSeleccionada.TasaAdministrativaIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Descuento tercera edad</td>
                                        <td>- @_declaracionSeleccionada.DescuentoTerceraEdadIat.ToString("N2")</td>
                                    </tr>
                                    <tr class="comprobante-simple-subtotal">
                                        <td>Total 1.5 x mil</td>
                                        <td>@TotalIat(_declaracionSeleccionada).ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="comprobante-simple-total">
                        <span>Total a pagar</span>
                        <strong>@TotalDeclaracion(_declaracionSeleccionada).ToString("N2")</strong>
                    </div>
                </div>
            </div>

            <div class="modal-detalle-actions">
                <button type="button"
                        class="btn-modal-secondary"
                        @onclick="CerrarDetalleDeclaracion">
                    Cerrar
                </button>

                <button type="button"
                        class="btn-modal-primary"
                        @onclick="ImprimirComprobante">
                    Reimprimir comprobante
                </button>
            </div>
        </div>
    </div>
}