@using gad.aaportal.commons.Dto.DtoPortal.Declaracion

<ToastsServices @ref="Toast" Time="5000" />
<LoadingBorderModalServices @ref="LoadingBorder" />
<ResumenEncabezadoContribuyenteForm />

<div class="consulta-declaraciones-container">
    <div class="consulta-declaraciones-card">
        <div class="consulta-declaraciones-header">
            <div>
                <div class="consulta-declaraciones-title">
                    Consulta de declaraciones
                </div>
                <div class="consulta-declaraciones-subtitle">
                    Revise las declaraciones registradas y reimprima el comprobante cuando lo requiera.
                </div>
            </div>

            <button type="button"
                    class="btn-consulta-refresh"
                    @onclick="RefrescarConsulta">
                Actualizar
            </button>
        </div>

        <div class="consulta-declaraciones-body">
            @if (_declaraciones.Any())
            {
                <div class="declaraciones-grid">
                    @foreach (var item in _declaraciones)
                    {
                        <div class="declaracion-consulta-card">
                            <div class="declaracion-card-header">
                                <div>
                                    <div class="declaracion-card-title">
                                        Declaración @item.Anio
                                    </div>
                                    <div class="declaracion-card-subtitle">
                                        Ejercicio Fiscal I.R. @(item.Anio - 1)
                                    </div>
                                    @*                                     <div class="declaracion-card-subtitle">
                                        Código: @item.CodigoUnicoPago
                                    </div> *@
                                </div>

                                <span class="declaracion-estado">
                                    Registrada
                                </span>
                            </div>

                            <div class="declaracion-card-info">
                                <div class="declaracion-info-item">
                                    <span>Código Único Pago (CUP)</span>
                                    <strong>@item.CodigoUnicoPago</strong>
                                </div>
                                <div class="declaracion-info-item">
                                    <span>Fecha registro</span>
                                    <strong>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>

                                <div class="declaracion-info-item">
                                    <span>Total patente</span>
                                    <strong>@TotalPatente(item).ToString("N2")</strong>
                                </div>

                                <div class="declaracion-info-item">
                                    <span>Total 1.5 x mil</span>
                                    <strong>@TotalIat(item).ToString("N2")</strong>
                                </div>

                                <div class="declaracion-info-item total">
                                    <span>Total a pagar</span>
                                    <strong>@TotalDeclaracion(item).ToString("N2")</strong>
                                </div>
                            </div>

                            <div class="declaracion-card-actions">
                                <button type="button"
                                        class="btn-ver-detalle"
                                        @onclick="() => AbrirDetalleDeclaracion(item)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-declaraciones">
                    No existen declaraciones registradas.
                </div>
            }
        </div>
    </div>
</div>

@if (_mostrarModalDetalle && _declaracionSeleccionada is not null)
{
    <div class="modal-backdrop-custom">
        <div id="comprobanteConsultaImprimir" class="modal-comprobante-card reporte-container">
            <!-- HEADER -->
            <div class="reporte-header">
                <div class="reporte-logo">
                    <img src="img/logoAA4.png" class="logo-img" />
                </div>
                <div class="reporte-titulo">
                    <div class="titulo-principal">
                        DECLARACIÓN DE PATENTE Y DEL 1.5 POR MIL SOBRE LOS ACTIVOS TOTALES
                    </div>
                </div>
                <button class="btn-close-modal" @onclick="CerrarDetalleDeclaracion">×</button>
            </div>
            <hr />
            <div class="modal-detalle-body">
                <div id="comprobanteConsultaImprimir">
                    <!-- RAZON SOCIAL -->
                    <div class="fila full">
                        <strong>RAZÓN SOCIAL:</strong> @_declaracionSeleccionada.RazonSocial
                    </div>
                    <!-- GRID SUPERIOR -->
                    <div class="grid-2">
                        <div><strong>RUC:</strong> @_declaracionSeleccionada.Identificacion</div>
                        <div>
                            <strong>Nro. PATENTE:</strong>
                            @($"{_declaracionSeleccionada.CodigoUnicoPago}-{_declaracionSeleccionada.CodigoPatente}-{_declaracionSeleccionada.CodigoIat}")
                        </div>

                        <div><strong>AÑO DECLARACIÓN:</strong> @_declaracionSeleccionada.Anio</div>
                        <div><strong>AÑO IMPUESTO RENTA:</strong> @(_declaracionSeleccionada.Anio - 1)</div>
                    </div>
                    <hr />
                    <!-- 🔥 BALANCE CORREGIDO -->
                    <div class="balance-grid">
                        <!-- IZQUIERDA -->
                        <div class="columna">
                            <div class="item">
                                <span>ACTIVO CORRIENTE:</span>
                                <strong>@_declaracionSeleccionada.ActivoCorriente.ToString("N2")</strong>
                            </div>

                            <div class="item">
                                <span>ACTIVO NO CORRIENTE:</span>
                                <strong>@_declaracionSeleccionada.ActivoNoCorriente.ToString("N2")</strong>
                            </div>

                            <div class="item total">
                                <span>TOTAL ACTIVOS:</span>
                                <strong>@TotalActivo(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>
                        </div>
                        <!-- DERECHA -->
                        <div class="columna">
                            <div class="item">
                                <span>PASIVO CORRIENTE:</span>
                                <strong>@_declaracionSeleccionada.PasivoCorriente.ToString("N2")</strong>
                            </div>
                            <div class="item">
                                <span>PASIVO NO CORRIENTE:</span>
                                <strong>@_declaracionSeleccionada.PasivoNoCorriente.ToString("N2")</strong>
                            </div>
                            <div class="item">
                                <span>PASIVO CONTINGENTE:</span>
                                <strong>@_declaracionSeleccionada.PasivoContingente.ToString("N2")</strong>
                            </div>
                            <div class="item total">
                                <span>TOTAL PASIVOS:</span>
                                <strong>@TotalPasivo(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>
                            <div class="item total">
                                <span>PATRIMONIO:</span>
                                <strong>@Patrimonio(_declaracionSeleccionada).ToString("N2")</strong>
                            </div>
                        </div>

                    </div>
                    <hr />
                    <!-- INGRESOS -->
                    <div class="fila">
                        <strong>TOTAL INGRESOS:</strong> @_declaracionSeleccionada.Ingresos.ToString("N2")
                    </div>
                    <hr />
                    <!-- TABLAS -->
                    <div class="reporte-two-columns">
                        <!-- PATENTE -->
                        <div class="tabla-box">
                            <div class="tabla-header">IMPUESTO PATENTE MUNICIPAL</div>
                            <table class="tabla">
                                <tr><td>Base imponible</td><td>@Patrimonio(_declaracionSeleccionada).ToString("N2")</td></tr>
                                <tr><td>Impuesto</td><td>@_declaracionSeleccionada.Patente.ToString("N2")</td></tr>
                                <tr><td>Multa</td><td>@_declaracionSeleccionada.MultaPatente.ToString("N2")</td></tr>
                                <tr><td>Interés</td><td>@_declaracionSeleccionada.InteresPatente.ToString("N2")</td></tr>
                                <tr><td>Recargos</td><td>@_declaracionSeleccionada.RecargoPatente.ToString("N2")</td></tr>
                                <tr><td>Costas</td><td>@_declaracionSeleccionada.CostasPatente.ToString("N2")</td></tr>
                                <tr><td>Tasa adm.</td><td>@_declaracionSeleccionada.TasaAdministrativaPatente.ToString("N2")</td></tr>
                                <tr class="total-row">
                                    <td>Total patente</td>
                                    <td>@TotalPatente(_declaracionSeleccionada).ToString("N2")</td>
                                </tr>
                            </table>
                        </div>

                        <!-- 1.5 -->
                        <div class="tabla-box">
                            <div class="tabla-header">IMPUESTO 1.5 POR MIL</div>
                            <table class="tabla">
                                <tr><td>Base imponible</td><td>@Patrimonio(_declaracionSeleccionada).ToString("N2")</td></tr>
                                <tr><td>Impuesto</td><td>@_declaracionSeleccionada.UnoCincoXMil.ToString("N2")</td></tr>
                                <tr><td>Multa</td><td>@_declaracionSeleccionada.MultaIat.ToString("N2")</td></tr>
                                <tr><td>Interés</td><td>@_declaracionSeleccionada.InteresIat.ToString("N2")</td></tr>
                                <tr><td>Recargos</td><td>@_declaracionSeleccionada.RecargoIat.ToString("N2")</td></tr>
                                <tr><td>Costas</td><td>@_declaracionSeleccionada.CostasIat.ToString("N2")</td></tr>
                                <tr><td>Tasa adm.</td><td>@_declaracionSeleccionada.TasaAdministrativaIat.ToString("N2")</td></tr>
                                <tr class="total-row">
                                    <td>Total 1.5 por mil</td>
                                    <td>@TotalIat(_declaracionSeleccionada).ToString("N2")</td>
                                </tr>
                            </table>
                        </div>

                    </div>

                    <!-- TOTAL -->
                    <div class="total-final">
                        TOTAL A PAGAR: @TotalDeclaracion(_declaracionSeleccionada).ToString("N2")
                    </div>

                    <div class="nota-final">
                        Los valores por intereses de mora, recargos y costas judiciales están sujetos a variación hasta la fecha efectiva de pago;
                        por tanto, el valor total a cancelar podrá modificarse
                    </div>

                </div>
            </div>

            <div class="modal-detalle-actions">
                <button class="btn-modal-secondary" @onclick="CerrarDetalleDeclaracion">Cerrar</button>
                <button class="btn-modal-primary" @onclick="ImprimirComprobante">Imprimir</button>
            </div>

        </div>
    </div>
}