<ToastsServices @ref="Toast" Time="5000" />
<LoadingBorderModalServices @ref="LoadingBorder" />

<ResumenEncabezadoContribuyenteForm />

<div class="declaracion-container">
    <div class="declaracion-action-card">
        <div>
            <div class="declaracion-action-title">Declaración de patente</div>
            <div class="declaracion-action-subtitle">
                Inicie una nueva declaración seleccionando el período correspondiente.
            </div>
        </div>

        <button type="button" class="btn-nueva-declaracion" disabled="@_procesoFinalizado" @onclick="AbrirModalPeriodo">
            Nueva declaración
        </button>
    </div>
    @if (_tieneRestriccionMunicipal)
    {
        <div class="restriccion-municipal-alert">
            <div class="restriccion-icon">⚠️</div>

            <div>
                <div class="restriccion-title">No puede realizar la declaración</div>
                <div class="restriccion-message">
                    @_mensajeRestriccionMunicipal
                </div>
            </div>
        </div>
    }
    @if (_declaracionIniciada is not null)
    {
        <div class="declaracion-wizard-card">
            <div class="wizard-periodo">
                <span>Período seleccionado:</span>
                <strong>@_declaracionIniciada.DescripcionPeriodo</strong>
            </div>

            <div class="wizard-steps">
                <div class="@ObtenerClaseStep(1)">
                    <div class="step-circle">1</div>
                    <div class="step-text">Declaración</div>
                </div>

                <div class="step-line"></div>

                <div class="@ObtenerClaseStep(2)">
                    <div class="step-circle">2</div>
                    <div class="step-text">Resumen</div>
                </div>

                @*                 <div class="step-line"></div>

                <div class="@ObtenerClaseStep(3)">
                    <div class="step-circle">3</div>
                    <div class="step-text">Pago</div>
                </div> *@

                <div class="step-line"></div>

                <div class="@ObtenerClaseStep(3)">
                    <div class="step-circle">3</div>
                    <div class="step-text">Finalización</div>
                </div>
            </div>

            <div class="wizard-content">
                @if (_stepActual == 1)
                {
                    <div class="step-panel">
                        <div class="panel-title">Declaración</div>
                        <div class="panel-subtitle">
                            Complete y verifique la información financiera para calcular la declaración.
                        </div>

                        <!-- 🔥 NUEVO CONTENEDOR GRID -->
                        <div class="declaracion-grid-2cols">

                            <!-- ACTIVO -->
                            <div class="declaracion-form-section">
                                <div class="section-title">Activos</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Activo Corriente <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.ActivoCorriente.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.ActivoCorriente" readonly /> *@
                                    </div>

                                    <div class="valor-row">
                                        <label>Activo No Corriente <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.ActivoNoCorriente.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.ActivoNoCorriente" readonly /> *@
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Total de Activo</label>
                                        <div class="valor-total">@TotalActivo.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PASIVO -->
                            <div class="declaracion-form-section">
                                <div class="section-title">Pasivos</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Pasivo Corriente <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.PasivoCorriente.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoCorriente" readonly /> *@
                                    </div>

                                    <div class="valor-row">
                                        <label>Pasivo No Corriente <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.PasivoNoCorriente.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoNoCorriente" readonly /> *@
                                    </div>

                                    <div class="valor-row">
                                        <label>Pasivo Contingente <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.PasivoContingente.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoContingente" readonly /> *@
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Total de Pasivo</label>
                                        <div class="valor-total">@TotalPasivo.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PATRIMONIO -->
                            <div class="declaracion-form-section">
                                @* <div class="section-title">Patrimonio</div> *@

                                <div class="valores-grid">
                                    <div class="valor-row total-row">
                                        <label>Patrimonio</label>
                                        <div class="valor-total">@Patrimonio.ToString("N2")</div>
                                        <span></span>
                                    </div>

                                    <div class="valor-row">
                                        <label>Ingresos <span>*</span></label>
                                        <div class="valor-total">@_valoresDeclaracion.Ingresos.ToString("N2")</div>
                                        @* <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.Ingresos" readonly /> *@
                                    </div>

                                    <div class="valor-row total-row" hidden>
                                        <label>Base Imponible 1.5 x 1000</label>
                                        <div class="valor-total">@BaseImponible.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PERDIDAS Y GANANCIAS -->
                            <div class="declaracion-form-section" hidden>
                                <div class="section-title">Pérdidas y Ganancias</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Ingresos <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.Ingresos" readonly />
                                    </div>

                                    <div class="valor-row">
                                        <label>Costos y Gastos <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.CostosGastos" readonly />
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Utilidad del Ejercicio</label>
                                        <div class="valor-total">@UtilidadEjercicio.ToString("N2")</div>
                                        <span></span>
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Pérdida del Ejercicio</label>
                                        <div class="valor-total">@PerdidaEjercicio.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- 🔥 FIN GRID -->

                        <div class="declaracion-form-section">
                            <div class="section-header">
                                <div>
                                    <div class="section-title">Distribución Cantonal</div>
                                    <div class="section-subtitle">
                                        Edite los porcentajes.
                                    </div>
                                </div>
                            </div>

                            <div class="establecimientos-table-wrapper">
                                <table class="establecimientos-table">
                                    <thead>
                                        <tr>
                                            <th>Cantón</th>
                                            <th>Base Imponible Patente</th>
                                            <th>Base Imponible IAT</th>
                                            <th>Porcentaje</th>
                                            <th hidden>Valor</th>
                                            <th hidden>Paga impuesto aquí</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _establecimientos)
                                        {
                                            <tr class="@(item.EsMunicipioBase ? "municipio-base-row" : "")">
                                                <td>
                                                    <div class="cantonal-title">
                                                        @item.Provincia

                                                        @if (item.EsMunicipioBase)
                                                        {
                                                            <span class="municipio-base-badge">Municipio base</span>
                                                        }
                                                    </div>

                                                    <div class="cantonal-subtitle">@item.Canton</div>
                                                </td>

                                                <td>
                                                    <div class="valor-total">@item.BaseImponible.ToString("N2")</div>
                                                    @*                                         <InputNumber class="input-form text-end input-disabled"
                                                                 @bind-Value="item.BaseImponible"
                                                                 disabled /> *@
                                                </td>
                                                <td>
                                                    <div class="valor-total">@item.BaseImponibleIat.ToString("N2")</div>
                                                    @*                          <InputNumber class="input-form text-end input-disabled"
                                                                 @bind-Value="item.BaseImponibleIat"
                                                                 disabled /> *@
                                                </td>


                                                <td>
                                                    <InputNumber class="input-form text-end" @bind-Value="item.Porcentaje" @bind-Value:after="InvalidarCalculo" disabled="@_deshabilitaPorcentajeCantonUnico" />
                                                </td>

                                                <td class="text-end table-money" hidden>
                                                    @item.Valor.ToString("N2")
                                                </td>

                                                <td class="text-center" hidden>
                                                    <InputCheckbox @bind-Value="item.AplicaPago" @bind-Value:after="InvalidarCalculo" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr hidden>
                                            <td colspan="2"><strong>Suma Desglose</strong></td>
                                            <td class="text-end"><strong>@SumaPorcentaje.ToString("N2") %</strong></td>
                                            <td class="text-end"><strong>@TotalPatentePorEstablecimientos.ToString("N2")</strong></td>
                                            <td hidden></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="calculo-impuestos-card">
                                <div class="calculo-impuesto-item patente-card">
                                    <div class="calculo-impuesto-header">
                                        <span>Impuesto Patente</span>
                                    </div>

                                    <div class="calculo-impuesto-row">
                                        <span>Base Imponible Patente</span>
                                        <strong>@BaseImponiblePatentePorcentaje.ToString("N2")</strong>
                                    </div>

                                    <div class="calculo-impuesto-row total">
                                        <span>Valor Patente</span>
                                        <strong>@TotalPatentePorEstablecimientos.ToString("N2")</strong>
                                    </div>
                                </div>

                                <div class="calculo-impuesto-item uno-cinco-card">
                                    <div class="calculo-impuesto-header">
                                        <span>Impuesto 1.5 x 1000</span>
                                        <label>
                                            <InputCheckbox @bind-Value="registraPagoIAT" @bind-Value:after="PagoOtroCanton" />
                                            Registrar Pago IAT
                                        </label>
                                    </div>

                                    <div class="calculo-impuesto-row">
                                        <span>Base Imponible 1.5 x 1000</span>
                                        <strong>@BaseImponibleIatPorcentaje.ToString("N2")</strong>
                                    </div>

                                    <div class="calculo-impuesto-row total">
                                        <span>Valor 1.5 x 1000</span>
                                        <strong>@ValorUnoCincoPorMil.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (TieneMensajeValidacionCalculo)
                        {
                            <div class="restriccion-municipal-alert">
                                <div class="restriccion-icon">!</div>
                                <div>
                                    <div class="restriccion-title">No puede continuar la declaración</div>
                                    <div class="restriccion-message">
                                        @_mensajeValidacionCalculo
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="wizard-actions">
                            <button type="button" class="btn btn-lg btn-color-per btn-wizard" @onclick="CalcularDeclaracion">
                                Calcular
                            </button>

                            <button type="button" class="btn btn-lg btn-color-per btn-wizard" disabled="@(!_declaracionCalculada)" @onclick="SiguienteStep">
                                Continuar
                            </button>
                        </div>
                    </div>
                }

                @if (_stepActual == 2)
                {
                    <div class="step-panel">
                        <div class="panel-title">Resumen</div>
                        <div class="panel-subtitle">
                            Revise los valores generados antes de continuar con el pago.
                        </div>
                        <div class="resumen-impuestos-grid">
                            <div class="impuesto-card">
                                <div class="impuesto-card-title d-flex justify-content-between align-items-center">
                                    <span>Patente</span>
                                </div>
                                <div class="impuesto-row impuesto-total">
                                    <span>Base Imponible</span>
                                    <strong>@_resumen.Patrimonio.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Impuesto</span>
                                    <strong>+@_resumen.DerechoPatenteAnual.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Exoneración tercera edad</span>
                                    <strong>- @_resumen.DescuentoPatenteTerceraEdad.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Subtotal</span>
                                    <strong>@((_resumen.DerechoPatenteAnual - _resumen.DescuentoPatenteTerceraEdad).ToString("C2"))</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Multa</span>
                                    <strong>+ @_resumen.MultaPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Interés por mora</span>
                                    <strong>+ @InteresPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Recargo</span>
                                    <strong>+ @RecargoPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Costas judiciales</span>
                                    <strong>+ @CostasPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Tasa administrativa</span>
                                    <strong>+ @TasaAdministrativaPatente.ToString("C2")</strong>
                                </div>
                                @if (MostrarValorBomberos)
                                {
                                    <div class="impuesto-row">
                                        <span>Valor Bomberos</span>
                                        <strong>+ @_resumen.ValoresBomberosPatente.ToString("C2")</strong>
                                    </div>
                                }


                                <div class="impuesto-row impuesto-total">
                                    <span>Total patente a pagar</span>
                                    <strong>@_resumen.TotalPatentePagar.ToString("C2")</strong>
                                </div>

                            </div>

                            <div class="impuesto-card">
                                <div class="impuesto-card-title d-flex justify-content-between align-items-center">
