@if (_mostrarModalComprobante && _declaracionRegistrada is not null)
{
    <div class="modal-backdrop-custom">
        <div id="comprobanteImprimir" class="modal-comprobante-card reporte-container">

            <!-- HEADER -->
            <div class="reporte-header">
                <div class="reporte-logo">
                    <img src="img/logoAA4.png" class="logo-img" />
                </div>

                <div class="reporte-titulo">
                    <div class="titulo-principal">
                        DECLARACIÓN DE PATENTE Y DEL 1.5 POR MIL SOBRE LOS ACTIVOS TOTALES
                    </div>
                </div>

                <button class="btn-close-modal" @onclick="CerrarModalComprobante">×</button>
            </div>

            <hr />

            <div class="modal-periodo-body">

                <!-- GRID SUPERIOR -->
                <div class="fila full">
                    <strong>RAZÓN SOCIAL:</strong> @razSocial
                </div>
                <!-- GRID SUPERIOR -->
                <div class="grid-2">
                    <div><strong>RUC:</strong> @_declaracionRegistrada.Identificacion</div>
                    <div>
                        <strong>Nro. PATENTE:</strong>
                        @($"{_declaracionRegistrada.CodigoUnicoPago}-{_declaracionRegistrada.CodigoPatente}-{_declaracionRegistrada.CodigoIat}")
                    </div>

                    <div><strong>AÑO DECLARACIÓN:</strong> @_declaracionRegistrada.FechaRegistro.Year</div>
                    <div><strong>AÑO IMPUESTO RENTA:</strong> @(_declaracionRegistrada.FechaRegistro.Year - 1)</div>
                    <div><strong>FECHA DECLARACIÓN:</strong> @(_declaracionRegistrada.FechaRegistro.ToString("dd/MM/yyyy"))</div>
                </div>

                <hr />

                <!-- 🔥 BALANCE (MISMO QUE EL BUENO) -->
                <div class="balance-grid">

                    <!-- IZQUIERDA -->
                    <div class="columna">
                        <div class="item">
                            <span>ACTIVO CORRIENTE:</span>
                            <strong>@_declaracionRegistrada.ActivoCorriente.ToString("N2")</strong>
                        </div>

                        <div class="item">
                            <span>ACTIVO NO CORRIENTE:</span>
                            <strong>@_declaracionRegistrada.ActivoNoCorriente.ToString("N2")</strong>
                        </div>
                        <div class="item">
                            <span>&nbsp;</span>
                        </div>
                        <div class="item total">
                            <span>TOTAL ACTIVOS:</span>
                            <strong>@TotalActivo.ToString("N2")</strong>
                        </div>
                        <div class="item total">
                            <span>TOTAL INGRESOS:</span>
                            <strong>@_declaracionRegistrada.Ingresos.ToString("N2")</strong>
                        </div>
                        <div class="item total">
                            <span>% ANTONIO ANTE:</span>
                            <strong>@(_establecimientos.FirstOrDefault(p => p.EsMunicipioBase)!.Porcentaje.ToString("N2"))%</strong>
                        </div>
                    </div>

                    <!-- DERECHA -->
                    <div class="columna">
                        <div class="item">
                            <span>PASIVO CORRIENTE:</span>
                            <strong>@_declaracionRegistrada.PasivoCorriente.ToString("N2")</strong>
                        </div>

                        <div class="item">
                            <span>PASIVO NO CORRIENTE:</span>
                            <strong>@_declaracionRegistrada.PasivoNoCorriente.ToString("N2")</strong>
                        </div>

                        <div class="item">
                            <span>PASIVO CONTINGENTE:</span>
                            <strong>@_declaracionRegistrada.PasivoContingente.ToString("N2")</strong>
                        </div>

                        <div class="item total">
                            <span>TOTAL PASIVOS:</span>
                            <strong>@TotalPasivo.ToString("N2")</strong>
                        </div>

                        <div class="item total">
                            <span>PATRIMONIO:</span>
                            <strong>@Patrimonio.ToString("N2")</strong>
                        </div>
                    </div>

                </div>

                <hr />

                <!-- TABLAS (MISMO ESTILO) -->
                <div class="reporte-two-columns">

                    <!-- PATENTE -->
                    <div class="tabla-box">
                        <div class="tabla-header">IMPUESTO PATENTE MUNICIPAL</div>
                        <table class="tabla">
                            <tr><td>Base imponible</td><td>@BaseImponiblePatentePorcentaje.ToString("N2")</td></tr>
                            <tr><td>Impuesto</td><td>@((_resumen.DerechoPatenteAnual).ToString("N2"))</td></tr>
                            <tr><td>Exoneración tercera edad</td><td>@((ValorExoneradoPatente).ToString("N2"))</td></tr>
                            <tr><td>Subtotal</td><td>@((_resumen.DerechoPatenteAnual - ValorExoneradoPatente).ToString("N2"))</td></tr>
                            <tr><td>Tasa Bomberos</td><td>@_resumen.ValoresBomberosPatente.ToString("N2")</td></tr>
                            <tr><td>Multa</td><td>@_resumen.MultaPatente.ToString("N2")</td></tr>
                            <tr><td>Interés por mora</td><td>@InteresPatente.ToString("N2")</td></tr>
                            <tr><td>Recargos</td><td>@RecargoPatente.ToString("N2")</td></tr>
                            <tr><td>Costas judiciales</td><td>@CostasPatente.ToString("N2")</td></tr>
                            <tr><td>Tasa administrativa</td><td>@TasaAdministrativaPatente.ToString("N2")</td></tr>
                            <tr class="total-row">
                                <td>Total patente</td>
                                <td>@_resumen.TotalPatentePagar.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>

                    <!-- 1.5 -->
                    <div class="tabla-box">
                        <div class="tabla-header">IMPUESTO 1.5 POR MIL</div>
                        <table class="tabla">
                            <tr><td>Base imponible</td><td>@_resumen.BaseImponible1_5_x_1000.ToString("N2")</td></tr>
                            <tr><td>Impuesto</td><td>@((_resumen.ImpuestoActivos).ToString("N2"))</td></tr>
                            <tr><td>Exoneración tercera edad</td><td>@((ValorExoneradoIAT).ToString("N2"))</td></tr>
                            <tr><td>Subtotal</td><td>@((_resumen.ImpuestoActivos - ValorExoneradoIAT).ToString("N2"))</td></tr>
                            <tr><td>Multa</td><td>@_resumen.Multa15.ToString("N2")</td></tr>
                            <tr><td>Interés por mora</td><td>@InteresIat.ToString("N2")</td></tr>
                            <tr><td>Recargos</td><td>@RecargoIat.ToString("N2")</td></tr>
                            <tr><td>Costas judiciales</td><td>@CostasIat.ToString("N2")</td></tr>
                            <tr><td>Tasa administrativa</td><td>@TasaAdministrativaIat.ToString("N2")</td></tr>
                            <tr><td>&nbsp;</td><td></td></tr>
                            <tr class="total-row">
                                <td>Total 1.5 por mil</td>
                                <td>@_resumen.Total15Pagar.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>

                </div>

                <!-- TOTAL -->
                <div class="total-final">
                    TOTAL A PAGAR: @_resumen.TotalPagar.ToString("N2")
                </div>
                <div class="comprobante-footer">
                    <div class="fecha-final">
                        <strong>Fecha:</strong> @FechaGeneracion.ToString("dd-MM-yyyy HH:mm:ss")
                    </div>

                    <div class="nota-final">
                        <strong>NOTA:</strong> Los valores por intereses de mora, recargos y costas judiciales están sujetos a variación hasta la fecha efectiva de pago;
                        por tanto, el valor total a cancelar podrá modificarse.
                    </div>
                </div>
            </div>

            <!-- BOTONES -->
            <div class="modal-detalle-actions">
                <button class="btn-modal-secondary" @onclick="CerrarModalComprobante">Cerrar</button>
                <button class="btn-modal-primary" @onclick="ImprimirComprobante">Imprimir</button>
            </div>

        </div>
    </div>
}