                                        </div>
                                        <div class="impuesto-row">
                                            <span>Multa</span>
                                            <strong>+ @_resumen.Multa15.ToString("C2")</strong>
                                        </div>
                                        @*                                     @if (InteresIat > 0)
                                        { *@
                                        <div class="impuesto-row">
                                            <span>Interés por mora</span>
                                            <strong>+ @InteresIat.ToString("C2")</strong>
                                        </div>
                                        @*    } *@
                                        @*                    @if (RecargoIat > 0)
                                        { *@
                                        <div class="impuesto-row">
                                            <span>Recargo</span>
                                            <strong>+ @RecargoIat.ToString("C2")</strong>
                                        </div>
                                        @*    } *@
                                        @*       @if (CostasIat > 0)
                                        { *@
                                        <div class="impuesto-row">
                                            <span>Costas judiciales</span>
                                            <strong>+ @CostasIat.ToString("C2")</strong>
                                        </div>
                                        @*   } *@
                                        @*      @if (TasaAdministrativaIat > 0)
                                        { *@
                                        <div class="impuesto-row">
                                            <span>Tasa administrativa</span>
                                            <strong>+ @TasaAdministrativaIat.ToString("C2")</strong>
                                        </div>
                                        @*  } *@
                                        <div class="impuesto-row impuesto-total">
                                            <span>Total 1.5 a pagar</span>
                                            <strong>@_resumen.Total15Pagar.ToString("C2")</strong>
                                        </div>

                                    </div>
                                </div>
                                <div class="total-pagar-card">
                                    <span>Total a Pagar</span>
                                    <strong>@_resumen.TotalPagar.ToString("C2")</strong>
                                </div>
                                <div class="wizard-actions">
                                    <button type="button"
                                            class="btn btn-color-per btn-wizard"
                                            @onclick="AbrirModalComprobante">
                                        Imprimir comprobante
                                    </button>

                                    <button type="button"
                                            class="btn-wizard-secondary"
                                            @onclick="IrConsultaDeclaraciones">
                                        Consultar
                                    </button>

                                    <button type="button"
                                            class="btn-wizard-secondary"
                                            @onclick="VolverInicioDeclaracion">
                                        Nueva declaración
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-step">
                                No existe información registrada de la declaración.
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

