@using gad.aaportal.commons.Dto.Declaracion

<ToastsServices @ref="Toast" Time="5000" />
<LoadingBorderModalServices @ref="LoadingBorder" />

<ResumenEncabezadoContribuyenteForm />

<div class="declaracion-container">
    <div class="declaracion-action-card">
        <div>
            <div class="declaracion-action-title">Declaración de patente</div>
            <div class="declaracion-action-subtitle">
                Inicie una nueva declaración seleccionando el período correspondiente.
            </div>
        </div>

        <button type="button" class="btn-nueva-declaracion" disabled="@_procesoFinalizado" @onclick="AbrirModalPeriodo">
            Nueva declaración
        </button>
    </div>
    @if (_tieneRestriccionMunicipal)
    {
        <div class="restriccion-municipal-alert">
            <div class="restriccion-icon">⚠️</div>

            <div>
                <div class="restriccion-title">No puede realizar la declaración</div>
                <div class="restriccion-message">
                    @_mensajeRestriccionMunicipal
                </div>
            </div>
        </div>
    }
    @if (_declaracionIniciada is not null)
    {
        <div class="declaracion-wizard-card">
            <div class="wizard-periodo">
                <span>Período seleccionado:</span>
                <strong>@_declaracionIniciada.DescripcionPeriodo</strong>
            </div>

            <div class="wizard-steps">
                <div class="@ObtenerClaseStep(1)">
                    <div class="step-circle">1</div>
                    <div class="step-text">Declaración</div>
                </div>

                <div class="step-line"></div>

                <div class="@ObtenerClaseStep(2)">
                    <div class="step-circle">2</div>
                    <div class="step-text">Resumen</div>
                </div>

                @*                 <div class="step-line"></div>

                <div class="@ObtenerClaseStep(3)">
                    <div class="step-circle">3</div>
                    <div class="step-text">Pago</div>
                </div> *@

                <div class="step-line"></div>

                <div class="@ObtenerClaseStep(3)">
                    <div class="step-circle">3</div>
                    <div class="step-text">Finalización</div>
                </div>
            </div>

            <div class="wizard-content">
                @if (_stepActual == 1)
                {
                    <div class="step-panel">
                        <div class="panel-title">Declaración</div>
                        <div class="panel-subtitle">
                            Complete y verifique la información financiera para calcular la declaración.
                        </div>

                        <!-- 🔥 NUEVO CONTENEDOR GRID -->
                        <div class="declaracion-grid-2cols">

                            <!-- ACTIVO -->
                            <div class="declaracion-form-section">
                                <div class="section-title">Activos</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Activo Corriente <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.ActivoCorriente" readonly />
                                    </div>

                                    <div class="valor-row">
                                        <label>Activo No Corriente <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.ActivoNoCorriente" readonly />
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Total de Activo</label>
                                        <div class="valor-total">@TotalActivo.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PASIVO -->
                            <div class="declaracion-form-section">
                                <div class="section-title">Pasivos</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Pasivo Corriente <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoCorriente" readonly />
                                    </div>

                                    <div class="valor-row">
                                        <label>Pasivo No Corriente <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoNoCorriente" readonly />
                                    </div>

                                    <div class="valor-row">
                                        <label>Pasivo Contingente <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.PasivoContingente" readonly />
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Total de Pasivo</label>
                                        <div class="valor-total">@TotalPasivo.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PATRIMONIO -->
                            <div class="declaracion-form-section">
                                @* <div class="section-title">Patrimonio</div> *@

                                <div class="valores-grid">
                                    <div class="valor-row total-row">
                                        <label>Patrimonio</label>
                                        <div class="valor-total">@Patrimonio.ToString("N2")</div>
                                        <span></span>
                                    </div>

                                    <div class="valor-row">
                                        <label>Ingresos <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.Ingresos" readonly />
                                    </div>

                                    <div class="valor-row total-row" hidden>
                                        <label>Base Imponible 1.5 x 1000</label>
                                        <div class="valor-total">@BaseImponible.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <!-- PERDIDAS Y GANANCIAS -->
                            <div class="declaracion-form-section" hidden>
                                <div class="section-title">Pérdidas y Ganancias</div>

                                <div class="valores-grid">
                                    <div class="valor-row">
                                        <label>Ingresos <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.Ingresos" readonly />
                                    </div>

                                    <div class="valor-row">
                                        <label>Costos y Gastos <span>*</span></label>
                                        <InputNumber class="input-form text-end" @bind-Value="_valoresDeclaracion.CostosGastos" readonly />
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Utilidad del Ejercicio</label>
                                        <div class="valor-total">@UtilidadEjercicio.ToString("N2")</div>
                                        <span></span>
                                    </div>

                                    <div class="valor-row total-row">
                                        <label>Pérdida del Ejercicio</label>
                                        <div class="valor-total">@PerdidaEjercicio.ToString("N2")</div>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- 🔥 FIN GRID -->

                        <div class="declaracion-form-section">
                            <div class="section-header">
                                <div>
                                    <div class="section-title">Distribución Cantonal</div>
                                    <div class="section-subtitle">
                                        Edite los porcentajes.
                                    </div>
                                </div>
                            </div>

                            <div class="establecimientos-table-wrapper">
                                <table class="establecimientos-table">
                                    <thead>
                                        <tr>
                                            <th>Cantón</th>
                                            <th>Base Imponible</th>
                                            <th>Porcentaje</th>
                                            <th>Valor</th>
                                            <th hidden>Paga impuesto aquí</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _establecimientos)
                                        {
                                            <tr class="@(item.EsMunicipioBase ? "municipio-base-row" : "")">
                                                <td>
                                                    <div class="cantonal-title">
                                                        @item.Provincia

                                                        @if (item.EsMunicipioBase)
                                                        {
                                                            <span class="municipio-base-badge">Municipio base</span>
                                                        }
                                                    </div>

                                                    <div class="cantonal-subtitle">@item.Canton</div>
                                                </td>

                                                <td>
                                                    <InputNumber class="input-form text-end input-disabled"
                                                                 @bind-Value="item.BaseImponible"
                                                                 disabled />
                                                </td>

                                                <td>
                                                    <InputNumber class="input-form text-end" @bind-Value="item.Porcentaje" @bind-Value:after="InvalidarCalculo" />
                                                </td>

                                                <td class="text-end table-money">
                                                    @item.Valor.ToString("N2")
                                                </td>

                                                <td class="text-center" hidden>
                                                    <InputCheckbox @bind-Value="item.AplicaPago" @bind-Value:after="InvalidarCalculo" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="2"><strong>Suma Desglose</strong></td>
                                            <td class="text-end"><strong>@SumaPorcentaje.ToString("N2") %</strong></td>
                                            <td class="text-end"><strong>@TotalPatentePorEstablecimientos.ToString("N2")</strong></td>
                                            <td hidden></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="calculo-impuestos-card">
                                <div class="calculo-impuesto-item patente-card">
                                    <div class="calculo-impuesto-header">
                                        <span>Impuesto Patente</span>
                                    </div>

                                    <div class="calculo-impuesto-row">
                                        <span>Base Imponible Patente</span>
                                        <strong>@Patrimonio.ToString("N2")</strong>
                                    </div>

                                    <div class="calculo-impuesto-row total">
                                        <span>Valor Patente</span>
                                        <strong>@TotalPatentePorEstablecimientos.ToString("N2")</strong>
                                    </div>
                                </div>

                                <div class="calculo-impuesto-item uno-cinco-card">
                                    <div class="calculo-impuesto-header">
                                        <span>Impuesto 1.5 x 1000</span>
                                    </div>

                                    <div class="calculo-impuesto-row">
                                        <span>Base Imponible 1.5 x 1000</span>
                                        <strong>@BaseImponible.ToString("N2")</strong>
                                    </div>

                                    <div class="calculo-impuesto-row total">
                                        <span>Valor 1.5 x 1000</span>
                                        <strong>@ValorUnoCincoPorMil.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (TieneMensajeValidacionCalculo)
                        {
                            <div class="restriccion-municipal-alert">
                                <div class="restriccion-icon">!</div>
                                <div>
                                    <div class="restriccion-title">No puede continuar la declaración</div>
                                    <div class="restriccion-message">
                                        @_mensajeValidacionCalculo
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="wizard-actions">
                            <button type="button" class="btn btn-lg btn-color-per btn-wizard" @onclick="CalcularDeclaracion">
                                Calcular
                            </button>

                            <button type="button" class="btn btn-lg btn-color-per btn-wizard" disabled="@(!_declaracionCalculada)" @onclick="SiguienteStep">
                                Continuar
                            </button>
                        </div>
                    </div>
                }

                @if (_stepActual == 2)
                {
                    <div class="step-panel">
                        <div class="panel-title">Resumen</div>
                        <div class="panel-subtitle">
                            Revise los valores generados antes de continuar con el pago.
                        </div>
                        <div class="resumen-impuestos-grid">
                            <div class="impuesto-card">
                                <div class="impuesto-card-title d-flex justify-content-between align-items-center">
                                    <span>Patente</span>
                                    @* <button type="button" class="btn btn-color-per btn-wizard" @onclick="PagoOtroCanton">
                                        Registrar pago
                                    </button> *@
                                </div>
                                <div class="impuesto-row impuesto-total">
                                    <span>Patrimonio</span>
                                    <strong>@_resumen.Patrimonio.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Derecho de patente anual</span>
                                    <strong>+@_resumen.DerechoPatenteAnual.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Multa por presentación tardía</span>
                                    <strong>+ @_resumen.MultaPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Interés</span>
                                    <strong>+ @InteresPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Recargo</span>
                                    <strong>+ @RecargoPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Costas judiciales</span>
                                    <strong>+ @CostasPatente.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Tasa administrativa</span>
                                    <strong>+ @TasaAdministrativaPatente.ToString("C2")</strong>
                                </div>
                                @if (MostrarValorBomberos)
                                {
                                    <div class="impuesto-row">
                                        <span>Valor Bomberos</span>
                                        <strong>+ @_resumen.ValoresBomberosPatente.ToString("C2")</strong>
                                    </div>
                                }
                                <div class="impuesto-row">
                                    <span>Descuento patente tercera edad</span>
                                    <strong>- @_resumen.DescuentoPatenteTerceraEdad.ToString("C2")</strong>
                                </div>


                                <div class="impuesto-row impuesto-total">
                                    <span>Total patente a pagar</span>
                                    <strong>@_resumen.TotalPatentePagar.ToString("C2")</strong>
                                </div>

                            </div>

                            <div class="impuesto-card">
                                <div class="impuesto-card-title">1.5 por mil</div>

                                <div class="impuesto-row impuesto-total">
                                    <span>Base Imponible 1.5 x mil</span>
                                    <strong>@_resumen.BaseImponible1_5_x_1000.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>1.5 x mil activos</span>
                                    <strong>+ @_resumen.ImpuestoActivos.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Multa por presentación tardía</span>
                                    <strong>+ @_resumen.Multa15.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Interés</span>
                                    <strong>+ @InteresIat.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Recargo</span>
                                    <strong>+ @RecargoIat.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Costas judiciales</span>
                                    <strong>+ @CostasIat.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Tasa administrativa</span>
                                    <strong>+ @TasaAdministrativaIat.ToString("C2")</strong>
                                </div>
                                <div class="impuesto-row">
                                    <span>Descuento tercera edad</span>
                                    <strong>- @_resumen.DescuentoTerceraEdad15.ToString("C2")</strong>
                                </div>

                                <div class="impuesto-row impuesto-total">
                                    <span>Total 1.5 a pagar</span>
                                    <strong>@_resumen.Total15Pagar.ToString("C2")</strong>
                                </div>

                            </div>
                        </div>

                        <div class="total-pagar-card">
                            <span>Total a Pagar</span>
                            <strong>@_resumen.TotalPagar.ToString("C2")</strong>
                        </div>

                        <div class="declaracion-form-section">
                            <div class="section-title">Desglose de otros cantones</div>

                            <div class="establecimientos-table-wrapper">
                                <table class="establecimientos-table">
                                    <thead>
                                        <tr>
                                            <th>Cantón</th>
                                            <th>Base Imponible</th>
                                            <th>Porcentaje</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _establecimientos)
                                        {
                                            <tr>
                                                <td>@item.Provincia - @item.Canton</td>
                                                <td class="text-end">@item.BaseImponible.ToString("C2")</td>
                                                <td class="text-end">@item.Porcentaje.ToString("N2") %</td>
                                                <td class="text-end">@item.Valor.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="wizard-actions">
                            <button type="button" class="btn-wizard-secondary" @onclick="AnteriorStep">
                                Regresar
                            </button>

                            <button type="button" class="btn btn-color-per btn-wizard" disabled="@(!_declaracionCalculada)" @onclick="AbrirModalConfirmarValores">
                                Confirmar Valores
                            </button>
                        </div>
                    </div>
                }

                @*                 @if (_stepActual == 3)
                {
                    <div class="step-panel">
                        <div class="panel-title">Pago</div>
                        <div class="panel-subtitle">
                            Seleccione o confirme la forma de pago de la declaración.
                        </div>

                        <div class="empty-step">
                            Aquí irá el flujo de pago.
                        </div>

                        <div class="wizard-actions">
                            <button type="button" class="btn-wizard-secondary" @onclick="AnteriorStep">
                                Regresar
                            </button>
                            <button type="button" class="btn btn-lg btn-color-per btn-wizard" @onclick="SiguienteStep">
                                Finalizar
                            </button>
                        </div>
                    </div>
                } *@

                @if (_stepActual == 3)
                {
                    <div class="step-panel">
                        <div class="panel-title">Finalización</div>
                        <div class="panel-subtitle">
                            La declaración fue registrada correctamente.
                        </div>

                        @if (_declaracionRegistrada is not null)
                        {
                            <div class="finalizacion-card">
                                <div class="finalizacion-icon">✓</div>

                                <div class="finalizacion-title">
                                    Declaración registrada
                                </div>

                                <div class="finalizacion-subtitle">
                                    Código único de pago:
                                    <strong>@_declaracionRegistrada.ActividadGenerada</strong>
                                </div>
                                <!-- AQUÍ VA EL NUEVO RESUMEN EN 4 SECCIONES -->
                                <div class="resumen-impuestos-grid">
                                    <div class="impuesto-card">
                                        <div class="impuesto-card-title">Patente</div>
                                        <div class="impuesto-row impuesto-total">
                                            <span>Patrimonio</span>
                                            <strong>@_resumen.Patrimonio.ToString("C2")</strong>
                                        </div>
                                        <div class="impuesto-row">
                                            <span>Derecho de patente anual</span>
                                            <strong>+@_resumen.DerechoPatenteAnual.ToString("C2")</strong>
                                        </div>
                                        <div class="impuesto-row">
                                            <span>Multa por presentación tardía</span>
                                            <strong>+ @_resumen.MultaPatente.ToString("C2")</strong>
                                        </div>
                                        @if (InteresPatente > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Interés</span>
                                                <strong>+ @InteresPatente.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (RecargoPatente > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Recargo</span>
                                                <strong>+ @RecargoPatente.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (CostasPatente > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Costas judiciales</span>
                                                <strong>+ @CostasPatente.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (TasaAdministrativaPatente > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Tasa administrativa</span>
                                                <strong>+ @TasaAdministrativaPatente.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (MostrarValorBomberos)
                                        {
                                            <div class="impuesto-row">
                                                <span>Valor Bomberos</span>
                                                <strong>+ @_resumen.ValoresBomberosPatente.ToString("C2")</strong>
                                            </div>
                                        }
                                        <div class="impuesto-row">
                                            <span>Descuento patente tercera edad</span>
                                            <strong>- @_resumen.DescuentoPatenteTerceraEdad.ToString("C2")</strong>
                                        </div>


                                        <div class="impuesto-row impuesto-total">
                                            <span>Total patente a pagar</span>
                                            <strong>@_resumen.TotalPatentePagar.ToString("C2")</strong>
                                        </div>

                                    </div>

                                    <div class="impuesto-card">
                                        <div class="impuesto-card-title">1.5 por mil</div>

                                        <div class="impuesto-row impuesto-total">
                                            <span>Base Imponible 1.5 x mil</span>
                                            <strong>@_resumen.BaseImponible1_5_x_1000.ToString("C2")</strong>
                                        </div>
                                        <div class="impuesto-row">
                                            <span>1.5 x mil activos</span>
                                            <strong>+ @_resumen.ImpuestoActivos.ToString("C2")</strong>
                                        </div>
                                        <div class="impuesto-row">
                                            <span>Multa por presentación tardía</span>
                                            <strong>+ @_resumen.Multa15.ToString("C2")</strong>
                                        </div>
                                        @if (InteresIat > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Interés</span>
                                                <strong>+ @InteresIat.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (RecargoIat > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Recargo</span>
                                                <strong>+ @RecargoIat.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (CostasIat > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Costas judiciales</span>
                                                <strong>+ @CostasIat.ToString("C2")</strong>
                                            </div>
                                        }
                                        @if (TasaAdministrativaIat > 0)
                                        {
                                            <div class="impuesto-row">
                                                <span>Tasa administrativa</span>
                                                <strong>+ @TasaAdministrativaIat.ToString("C2")</strong>
                                            </div>
                                        }
                                        <div class="impuesto-row">
                                            <span>Descuento tercera edad</span>
                                            <strong>- @_resumen.DescuentoTerceraEdad15.ToString("C2")</strong>
                                        </div>

                                        <div class="impuesto-row impuesto-total">
                                            <span>Total 1.5 a pagar</span>
                                            <strong>@_resumen.Total15Pagar.ToString("C2")</strong>
                                        </div>

                                    </div>
                                </div>
                                <div class="total-pagar-card">
                                    <span>Total a Pagar</span>
                                    <strong>@_resumen.TotalPagar.ToString("C2")</strong>
                                </div>
                                <div class="wizard-actions">
                                    <button type="button"
                                            class="btn btn-color-per btn-wizard"
                                            @onclick="AbrirModalComprobante">
                                        Imprimir comprobante
                                    </button>

                                    <button type="button"
                                            class="btn-wizard-secondary"
                                            @onclick="IrConsultaDeclaraciones">
                                        Consultar
                                    </button>

                                    <button type="button"
                                            class="btn-wizard-secondary"
                                            @onclick="VolverInicioDeclaracion">
                                        Nueva declaración
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-step">
                                No existe información registrada de la declaración.
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_mostrarModalPagoOtroCanton)
{
    <div class="modal-backdrop-custom">
        <div class="modal-periodo-card">
            <div class="modal-periodo-header">
                <div>
                    <div class="modal-title-custom">Declaración de pago en otro Cantón</div>
                    <div class="modal-subtitle-custom">
                        Para registrar el pago de sus impuestos en otro cantón registre los siguientes datos:
                    </div>
                </div>

                <button type="button" class="btn-close-modal" @onclick="CerrarModalPagoOtroCanton">×</button>
            </div>

            @* CAMBIAR METODO *@
            <EditForm Model="_periodoSeleccionado" OnValidSubmit="ConfirmarPeriodo">
                <DataAnnotationsValidator />
                <div class="modal-periodo-body">
                    <div class="form-field">
                        <label>Cantón<span>*</span></label>

                        <InputSelect class="input-form" @bind-Value="insertarTranferenciaIatDto.Canton">
                            <option value="0">Seleccione el canton donde genero su pago </option>
                            @foreach (var canton in _cantones.Cantones)
                            {
                                <option value="@canton.NombreCanton">
                                    @canton.NombreCanton
                                </option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>

                    <div class="form-field">
                        <label>Forma de pago<span>*</span></label>

                        <InputSelect class="input-form" @bind-Value="insertarTranferenciaIatDto.FormaPago">
                            <option value="0">Seleccione su forma de pago</option>
                            @foreach (var forma in formaPago)
                            {
                                <option value="@forma">
                                    @forma
                                </option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>

                    <div class="form-field">
                        <label>Nro de Documento<span>*</span></label>

                        <InputText class="input-form" @bind-Value="insertarTranferenciaIatDto.NroDocumento" />
                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>

                    <div class="form-field">
                        <label>Valor Pagado<span>*</span></label>

                        <InputNumber class="input-form" @bind-Value="insertarTranferenciaIatDto.Valor" />
                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>

                    <div class="form-field">
                        <label>Banco<span>*</span></label>

                        <InputText class="input-form" @bind-Value="insertarTranferenciaIatDto.Banco" />
                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>
                </div>

                <div class="modal-periodo-actions">
                    <button type="button" class="btn-modal-secondary" @onclick="CerrarModalPagoOtroCanton">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-modal-primary">
                        Continuar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
@if (_mostrarModalPeriodo)
{
    <div class="modal-backdrop-custom">
        <div class="modal-periodo-card">
            <div class="modal-periodo-header">
                <div>
                    <div class="modal-title-custom">Nueva Declaración</div>
                    <div class="modal-subtitle-custom">
                        Seleccione el año de declaración para continuar.
                    </div>
                </div>

                <button type="button" class="btn-close-modal" @onclick="CerrarModalPeriodo">×</button>
            </div>

            <EditForm Model="_periodoSeleccionado" OnValidSubmit="ConfirmarPeriodo">
                <DataAnnotationsValidator />

                <div class="modal-periodo-body">
                    <div class="form-field">
                        <label>Año de Declaración <span>*</span></label>

                        <InputSelect class="input-form" @bind-Value="_periodoSeleccionado.AnioDeclaracion">
                            <option value="0">Seleccione el año de declaración</option>
                            @foreach (var periodo in _periodosDeclaracion.PeriodosDeclaracion)
                            {
                                <option value="@periodo.AnioPatente">
                                    @periodo.Descripcion
                                </option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => _periodoSeleccionado.AnioDeclaracion)" />
                    </div>
                </div>

                <div class="modal-periodo-actions">
                    <button type="button" class="btn-modal-secondary" @onclick="CerrarModalPeriodo">
                        Cancelar
                    </button>

                    <button type="submit" class="btn-modal-primary">
                        Continuar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
@if (_mostrarModalConfirmarValores)
{
    <div class="modal-backdrop-custom">
        <div class="modal-periodo-card">
            <div class="modal-periodo-header">
                <div>
                    <div class="modal-title-custom">Confirmar valores</div>
                    <div class="modal-subtitle-custom">
                        Revise los valores calculados antes de registrar la declaración.
                    </div>
                </div>

                <button type="button"
                        class="btn-close-modal"
                        @onclick="CerrarModalConfirmarValores">
                    ×
                </button>
            </div>

            <div class="modal-periodo-body">
                <div class="confirmacion-valores-grid">
                    <div class="confirmacion-item full-row">
                        <span>Ejercicio fiscal</span>
                        <strong>@_declaracionIniciada?.EjercicioFiscal</strong>
                    </div>

                    <div class="confirmacion-item">
                        <span>Patrimonio</span>
                        <strong>@Patrimonio.ToString("N2")</strong>
                    </div>

                    <div class="confirmacion-item">
                        <span>Valor total patente</span>
                        <strong>@_resumen.TotalPatentePagar.ToString("N2")</strong>
                    </div>

                    <div class="confirmacion-item">
                        <span>Base imponible 1.5 x mil</span>
                        <strong>@BaseImponible.ToString("N2")</strong>
                    </div>

                    <div class="confirmacion-item">
                        <span>Valor Total 1.5 x mil</span>
                        <strong>@_resumen.Total15Pagar.ToString("N2")</strong>
                    </div>

                    <div class="confirmacion-item total">
                        <span>Total a pagar</span>
                        <strong>@_resumen.TotalPagar.ToString("N2")</strong>
                    </div>
                </div>

                <div class="confirmacion-alerta">
                    Al aceptar, la declaración será registrada y no podrá continuar modificando estos valores desde este formulario.
                </div>
            </div>

            <div class="modal-periodo-actions">
                <button type="button"
                        class="btn-modal-secondary"
                        @onclick="CerrarModalConfirmarValores">
                    Cancelar
                </button>

                <button type="button"
                        class="btn-modal-primary"
                        @onclick="AceptarConfirmacionValores">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
}
@if (_mostrarModalComprobante && _declaracionRegistrada is not null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-comprobante-card comprobante-simple-card">
            <div class="modal-periodo-header comprobante-simple-header-actions">
                <div>
                    <div class="modal-title-custom">Comprobante de declaración</div>
                    <div class="modal-subtitle-custom">
                        Código único de pago: @_declaracionRegistrada.CodigoUnicoPago
                    </div>
                </div>

                <button type="button"
                        class="btn-close-modal"
                        @onclick="CerrarModalComprobante">
                    ×
                </button>
            </div>

            <div class="modal-periodo-body comprobante-simple-body">
                <div id="comprobanteImprimir" class="comprobante-simple-box">

                    <div class="comprobante-simple-title">
                        <strong>GAD Municipal Antonio Ante</strong>
                        <span>Comprobante de declaración de patente</span>
                    </div>

                    <div class="comprobante-simple-section">
                        <div class="comprobante-simple-section-title">Datos de la declaración</div>

                        <div class="comprobante-simple-grid">
                            <div><span>Código único de pago</span><strong>@_declaracionRegistrada.CodigoUnicoPago</strong></div>
                            <div><span>Identificación</span><strong>@_declaracionRegistrada.Identificacion</strong></div>
                            <div><span>Fecha emisión</span><strong>@_declaracionRegistrada.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong></div>
                            <div><span>Declaración Patente / Ejercicio fiscal I.R.</span><strong>@_declaracionRegistrada.Anio / @(_declaracionRegistrada.Anio - 1)</strong></div>
                        </div>
                    </div>

                    <div class="comprobante-simple-section">
                        <div class="comprobante-simple-section-title">Información financiera declarada</div>

                        <div class="comprobante-simple-grid four-cols">
                            <div><span>Activo corriente</span><strong>@_declaracionRegistrada.ActivoCorriente.ToString("N2")</strong></div>
                            <div><span>Activo no corriente</span><strong>@_declaracionRegistrada.ActivoNoCorriente.ToString("N2")</strong></div>
                            <div><span>Total activo</span><strong>@TotalActivo.ToString("N2")</strong></div>
                            <div><span>Total pasivo</span><strong>@TotalPasivo.ToString("N2")</strong></div>

                            <div><span>Pasivo corriente</span><strong>@_declaracionRegistrada.PasivoCorriente.ToString("N2")</strong></div>
                            <div><span>Pasivo no corriente</span><strong>@_declaracionRegistrada.PasivoNoCorriente.ToString("N2")</strong></div>
                            <div><span>Pasivo contingente</span><strong>@_declaracionRegistrada.PasivoContingente.ToString("N2")</strong></div>
                            <div><span>Patrimonio</span><strong>@Patrimonio.ToString("N2")</strong></div>

                            <div><span>Ingresos</span><strong>@_declaracionRegistrada.Ingresos.ToString("N2")</strong></div>
                            <div><span>Costos y gastos</span><strong>@_declaracionRegistrada.CostosGastos.ToString("N2")</strong></div>
                            <div><span>Utilidad</span><strong>@UtilidadEjercicio.ToString("N2")</strong></div>
                            <div><span>Pérdida</span><strong>@PerdidaEjercicio.ToString("N2")</strong></div>
                        </div>
                    </div>

                    <div class="comprobante-simple-two-columns">

                        <div class="comprobante-simple-section">
                            <div class="comprobante-simple-section-title">Patente municipal</div>

                            <table class="comprobante-simple-table">
                                <tbody>
                                    <tr>
                                        <td>Patrimonio</td>
                                        <td>@_resumen.Patrimonio.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Valor patente</td>
                                        <td>@_resumen.DerechoPatenteAnual.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Bomberos</td>
                                        <td>@_resumen.ValoresBomberosPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Multa patente</td>
                                        <td>@_resumen.MultaPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Interés patente</td>
                                        <td>@InteresPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Recargo patente</td>
                                        <td>@RecargoPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Costas patente</td>
                                        <td>@CostasPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Tasa administrativa</td>
                                        <td>@TasaAdministrativaPatente.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Descuento tercera edad</td>
                                        <td>- @_resumen.DescuentoPatenteTerceraEdad.ToString("N2")</td>
                                    </tr>
                                    <tr class="comprobante-simple-subtotal">
                                        <td>Total patente</td>
                                        <td>@_resumen.TotalPatentePagar.ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="comprobante-simple-section">
                            <div class="comprobante-simple-section-title">1.5 x mil</div>

                            <table class="comprobante-simple-table">
                                <tbody>
                                    <tr>
                                        <td>Base imponible</td>
                                        <td>@_resumen.BaseImponible1_5_x_1000.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Valor 1.5 x mil</td>
                                        <td>@_resumen.ImpuestoActivos.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Multa 1.5 x mil</td>
                                        <td>@_resumen.Multa15.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Interés 1.5 x mil</td>
                                        <td>@InteresIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Recargo 1.5 x mil</td>
                                        <td>@RecargoIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Costas 1.5 x mil</td>
                                        <td>@CostasIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Tasa administrativa</td>
                                        <td>@TasaAdministrativaIat.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Descuento tercera edad</td>
                                        <td>- @_resumen.DescuentoTerceraEdad15.ToString("N2")</td>
                                    </tr>
                                    <tr class="comprobante-simple-subtotal">
                                        <td>Total 1.5 x mil</td>
                                        <td>@_resumen.Total15Pagar.ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <div class="comprobante-simple-total">
                        <span>Total a pagar</span>
                        <strong>@_resumen.TotalPagar.ToString("N2")</strong>
                    </div>
                </div>
            </div>

            <div class="modal-periodo-actions comprobante-simple-actions">
                <button type="button"
                        class="btn-modal-secondary"
                        @onclick="CerrarModalComprobante">
                    Cerrar
                </button>

                <button type="button"
                        class="btn-modal-primary"
                        @onclick="ImprimirComprobante">
                    Imprimir
                </button>
            </div>
        </div>
    </div>
}