<ToastsServices @ref="Toast" Time="5000" />
<LoadingBorderModalServices @ref="LoadingBorder" />

@if (_contribuyenteResumen?.Data is not null)
{
    var contribuyente = _contribuyenteResumen.Data;

    <div class="resumen-contribuyente-container">
        <div class="resumen-contribuyente-card">

            <div class="resumen-contribuyente-header">
                <div class="resumen-avatar">
                    <span class="resumen-avatar-icon">👤</span>
                </div>

                <div class="resumen-header-info">
                    <div class="resumen-title">@contribuyente.RazonSocial</div>
                    <div class="resumen-subtitle">
                        Información general del contribuyente
                    </div>
                </div>
            </div>

            <div class="resumen-divider"></div>

            <div class="resumen-info-grid">

                <div class="resumen-info-item">
                    <span class="resumen-label">RUC / Identificación</span>
                    <span class="resumen-value">@contribuyente.Identificacion</span>
                </div>

                <div class="resumen-info-item">
                    <span class="resumen-label">Tipo de Contribuyente</span>
                    <span class="resumen-value">@contribuyente.TipoContribuyente</span>
                </div>

                <div class="resumen-info-item resumen-info-full">
                    <span class="resumen-label">Actividad Económica</span>
                    <span class="resumen-value">@contribuyente.ActividadEconomica</span>
                </div>

                <div class="resumen-info-item">
                    <span class="resumen-label">Inicio de Actividades Económicas</span>
                    <span class="resumen-value">@contribuyente.InicioActividadEconomica</span>
                </div>

                <div class="resumen-info-item">
                    <span class="resumen-label">Contribuyente Especial</span>
                    <span class="resumen-value">@contribuyente.ContribuyenteEspecial</span>
                </div>

                <div class="resumen-info-item">
                    <span class="resumen-label">Obligado a Llevar Contabilidad</span>
                    <span class="resumen-value">@contribuyente.ObligadoLlevarContabilidad</span>
                </div>

            </div>
        </div>

        <div class="resumen-alerta">
            <strong>Recuerde:</strong>
            Estimado contribuyente, antes de iniciar la declaración en línea por favor registre la información obligatoria en la opción Actualización de datos.
        </div>
    </div>
}